# ===== Arena Juara — contoh konfigurasi =====
# Salin menjadi .env bila ingin mengatur (aplikasi juga membaca environment biasa).

# Port server (bawaan 3000)
PORT=3000

# Penyimpanan:
#  - Kosongkan DATABASE_URL  -> memakai berkas JSON (lokal, atau volume di hosting).
#  - Isi DATABASE_URL        -> memakai PostgreSQL (disarankan untuk online; data tahan lama).
# Contoh: postgres://user:password@host:5432/nama_db
#DATABASE_URL=

# Folder data untuk backend berkas (mis. /data saat memakai volume)
DATA_DIR=./data

# Batasi asal koneksi (opsional). Contoh: https://arena-juara.onrender.com
ALLOWED_ORIGIN=*

# Durasi permainan (opsional)
#AJ_Q_SECONDS=120
#AJ_ROUNDS_TO_WIN=3
#AJ_RESULT_MS=5000
